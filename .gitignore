venv/
node_modules/
.aider*

# Runtime state files — generated by the backend, contain user emails / IPs / Discord thread IDs.
# Never commit these. Per-instance, regenerated on the fly.
web_nexus/_*.json

# nohup.out — uvicorn stdout/stderr from background runs. Local-only.
nohup.out
web_nexus/nohup.out

# AI instruction files — contain architecture docs, security rules, deployment
# details. Keep local, don't expose on public GitHub.
CLAUDE.md
GEMINI.md
.claude/
.gemini/

# Cloudflare Worker — source IS tracked (auto-deployed via GitHub Action on
# push to main). Secrets live in CF Worker Secrets (env.* in code), never
# in source. Local state directories stay ignored.
worker/.wrangler/
worker/node_modules/
worker/package-lock.json
.wrangler/
